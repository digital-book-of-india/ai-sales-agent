# Hosted PostgreSQL (Supabase) connection string.
# Use the "Session pooler" URI from Supabase's Connect dialog, not the direct
# connection — the direct host only resolves to IPv6, which most networks
# can't reach. Session pooler host looks like aws-0-<region>.pooler.supabase.com.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Hosted Redis (Upstash) connection URL
REDIS_URL="rediss://default:PASSWORD@HOST:6379"

# Secret used to sign JWTs — replace with a long random value, never commit the real value
JWT_SECRET="replace-with-a-long-random-secret"

# App
PORT=3000
FRONTEND_URL="http://localhost:5173"

# Auth
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Seed script (npm run db:seed) — creates one demo user per role
SEED_ADMIN_EMAIL="admin@example.com"
SEED_MANAGER_EMAIL="manager@example.com"
SEED_EXECUTIVE_EMAIL="executive@example.com"
SEED_DEMO_PASSWORD="ChangeMe123!"
# WebRTC softphone secret seeded for the demo Sales Executive's extension
# 1001 — must match that extension's password in pjsip.internal.conf.
SEED_SIP_PASSWORD="demo-sip-secret-1001"

# Telephony provider — "mock" (default) simulates call outcomes locally with
# no credentials, exactly like the old CallProviderService did. Switch to
# "asterisk" only once every ASTERISK_*/AUDIOSOCKET_* value below is filled
# in and infra/asterisk/ has been deployed to the PBX server (see
# infra/asterisk/README.md). These credentials are backend-only — never
# expose them to the frontend.
TELEPHONY_PROVIDER="mock"

# AMI (Asterisk Manager Interface) connection — see
# infra/asterisk/etc/asterisk/manager.d/backend.conf.example. Never point
# this at a public IP; AMI is full call-control and must only be reachable
# from this backend server (bind + permit/deny + firewall on the PBX side —
# see infra/asterisk/README.md "Security").
ASTERISK_AMI_HOST="10.0.0.9"
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME="backend"
ASTERISK_AMI_PASSWORD="replace-with-the-same-secret-set-in-manager.d/backend.conf"
# The Airtel DID (caller id) this trunk originates calls as — see
# infra/asterisk/etc/asterisk/pjsip.airtel_trunk.conf.example.
ASTERISK_CALLER_ID="replace-with-airtel-did-number"
# How long (ms) Asterisk lets an outbound call ring before giving up.
ASTERISK_ORIGINATE_TIMEOUT_MS=30000

# Where AsteriskProvider.getRecording() builds signed recording URLs from —
# the internal-only nginx vhost in infra/asterisk/nginx/recordings-internal.conf.
# No trailing path (the /recordings/<file>.wav part is added automatically).
# ASTERISK_RECORDINGS_SECRET must exactly match the `secure_link_md5` secret
# baked into that nginx config. Generate with `openssl rand -hex 32`.
ASTERISK_RECORDINGS_BASE_URL="http://10.0.0.9:8088"
ASTERISK_RECORDINGS_SECRET="replace-with-a-long-random-secret"
ASTERISK_RECORDINGS_TTL_SECONDS=600

# AudioSocket — the raw TCP bridge carrying live call audio to the AI voice
# pipeline (see backend/src/calling/ai-voice/audiosocket.gateway.ts and
# infra/asterisk/etc/asterisk/extensions.conf's AI_AUDIOSOCKET_SERVICE
# global, which must point at this host:port). AUDIOSOCKET_HOST is what
# this backend process binds to — firewall it to the Asterisk server's IP
# only (see infra/asterisk/README.md "Security").
AUDIOSOCKET_HOST="0.0.0.0"
AUDIOSOCKET_PORT=9019
# Comma-separated allowlist of IPs allowed to open an AudioSocket
# connection — an in-process second layer on top of the firewall rule
# above. Leave unset only for local dev; always set in any deployment
# reachable from more than localhost.
ASTERISK_SERVER_IPS="10.0.0.9"

# Browser-based softphone (click-to-call — see UsersService.getSipCredentials
# and frontend/src/calling/softphone.ts). SIP.js/JsSIP in the rep's browser
# registers over WSS to ASTERISK_WSS_URI, using User.sipExtension /
# sipPassword as credentials against ASTERISK_SIP_DOMAIN (see
# infra/asterisk/etc/asterisk/pjsip.conf [transport-wss] and
# pjsip.internal.conf.example). Unlike the other ASTERISK_* vars this one
# IS exposed to the frontend (via the sip-credentials endpoint) — it must be
# a public wss:// URL, not an internal IP. Leave both unset for local/mock
# dev; the sip-credentials endpoint reports the softphone as unconfigured.
ASTERISK_WSS_URI="wss://pbx.example.com:8089/ws"
ASTERISK_SIP_DOMAIN="pbx.example.com"

# Real-time AI voice pipeline (see backend/src/calling/ai-voice/).
# Claude API key — resolved by the Anthropic SDK. Leave unset if this
# machine has an `ant auth login` profile active instead.
ANTHROPIC_API_KEY=
# Model + reasoning effort for the per-turn LLM reasoning call. Defaults to
# claude-opus-5 at "low" effort — low effort trades reasoning depth for the
# turn latency a live phone call needs; raise it if reply quality matters
# more than speed for a given deployment.
AI_VOICE_LLM_MODEL="claude-opus-5"
AI_VOICE_LLM_EFFORT="low"
# Sample rate the audio bridge streams call audio at (PCM16 mono). 8000 is
# standard telephony rate; match whatever the connected media bridge uses.
AI_VOICE_SAMPLE_RATE_HZ=8000
# Human handoff (see backend/src/calling/human-transfer/) resolves who to
# transfer a live AI call to per-call, from the lead's assigned salesperson
# (falling back to a sales manager) — there is no static routing target env
# var to set. Trigger thresholds/keywords are tunable via
# PATCH /system-settings/human_transfer (see
# system-settings/human-transfer.config.ts for defaults); the target must
# have a User.sipExtension registered (see [transfer-target] in
# infra/asterisk/etc/asterisk/extensions.conf) or the transfer is skipped
# and logged.

# Sarvam AI — speech-to-text and text-to-speech for the voice pipeline
# (see backend/src/calling/ai-voice/stt/sarvam-stt.provider.ts and
# .../tts/sarvam-tts.provider.ts). Get a key from dashboard.sarvam.ai.
SARVAM_API_KEY="replace-with-sarvam-api-key"
SARVAM_STT_WS_URL="wss://api.sarvam.ai/speech-to-text/ws"
SARVAM_STT_MODEL="saarika:v2.5"
SARVAM_TTS_WS_URL="wss://api.sarvam.ai/text-to-speech/ws"
SARVAM_TTS_MODEL="bulbul:v2"
# Optional fixed speaker/voice — omit to let Sarvam pick a default for the
# target language.
SARVAM_TTS_VOICE=
SARVAM_TTS_SAMPLE_RATE=8000

# Post-call analysis worker (see backend/src/calling/analysis/) — runs once
# per completed call, turning its transcript into a call_analyses row, a
# lead score (weighted rules configurable via
# PATCH /system-settings/lead_scoring, ADMIN only), and an updated Lead.
# Reuses ANTHROPIC_API_KEY above. Not latency-critical like the live-call
# reasoner, so "medium" effort is the default (vs AI_VOICE_LLM_EFFORT's "low").
POST_CALL_ANALYSIS_LLM_MODEL="claude-opus-5"
POST_CALL_ANALYSIS_LLM_EFFORT="medium"

# Recording playback/download links (see backend/src/calling/recordings/).
# Optional — falls back to JWT_SECRET when unset, but a dedicated secret is
# recommended so recording links and auth tokens don't share key material.
RECORDING_URL_SECRET=
# How long a signed play/download link stays valid, in seconds. Optional,
# defaults to 300 (5 minutes).
RECORDING_URL_TTL_SECONDS=300
